{
  "manifest_version": 3,
  "name": "Research Crawler · Selected Site Bridge",
  "version": "0.1.3",
  "minimum_chrome_version": "116",
  "description": "仅在您点击后，将当前选定站点的 Cookie 保存到本机指定账号。",
  "permissions": ["activeTab", "cookies", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": [
    "https://www.xiaohongshu.com/*", "http://www.xiaohongshu.com/*", "https://xiaohongshu.com/*", "http://xiaohongshu.com/*", "https://www.douyin.com/*",
    "https://www.kuaishou.com/*", "https://www.bilibili.com/*",
    "https://weibo.com/*", "https://tieba.baidu.com/*",
    "https://www.zhihu.com/*", "https://www.reddit.com/*"
  ],
  "action": {"default_popup": "launcher.html", "default_title": "导入选定站点"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8946"}
}
